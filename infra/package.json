{
  "name": "@paradays/commerce-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "watch": "tsc --watch --project tsconfig.json",
    "synth": "npm run build && cdk synth",
    "diff": "npm run build && cdk diff",
    "deploy": "npm run build && cdk deploy"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1136.0",
    "@aws-sdk/client-dynamodb": "^3.989.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.989.0",
    "@aws-sdk/lib-dynamodb": "^3.989.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.3.0",
    "aws-cdk": "^2.1142.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
