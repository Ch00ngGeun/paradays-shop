// 역할: 클라이언트(브라우저) SDK의 모든 Firestore 문서 읽기·쓰기를 거부하는 보안 규칙임.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 브라우저에서 PII를 색인·조회하는 경로를 제공하지 않습니다.
    // 향후 전화번호 중복 정책이 필요하면 Admin SDK가 있는 서버 경계에서 구현합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
